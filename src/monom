#!/usr/bin/env bash
# src/monom — sourced from user's rc file (.bashrc or .zshrc).
# Defines monom(), _setup_monom(), and _monom_cfg(), then sources the
# shell-specific completion binding.

export _MONOM_LIB_ROOT
export MONOM_ACTIVE
# Resolve the directory containing this file in a shell-agnostic way.
# ${(%):-%x} is zsh's equivalent of bash's ${BASH_SOURCE[0]} — it gives the
# path of the currently executing file even when sourced.
# shellcheck disable=SC2296
_monom_self="${ZSH_VERSION:+${(%):-%x}}${ZSH_VERSION:-${BASH_SOURCE[0]}}"
_MONOM_LIB_ROOT="$(cd "$(dirname "$_monom_self")" && pwd)"
unset _monom_self
MONOM_ACTIVE=1

# mnmd — thin wrapper so call sites read as `mnmd <subcommand>`.
# The binary ships next to the sources at ../bin/mnmd.
#
# `alias` is intercepted here rather than passed to the binary: binding an
# alias must define a function and register completion in the parent shell,
# which a subprocess cannot do. On interception the alias is persisted once via
# the binary (`alias-save`, which validates name and root) and, only if that
# succeeds, defined in the current shell so it is usable immediately.
mnmd() {
  local _bin
  _bin="$(cd "$_MONOM_LIB_ROOT/.." && pwd)/bin/mnmd"
  if [ "$1" = alias ]; then
    if [ "$#" -ne 3 ]; then
      echo "usage: mnmd alias <name> <path>" >&2
      return 1
    fi
    "$_bin" alias-save "$2" "$3" || return $?
    # alias-save validated "$3" as a project root, so cd cannot fail here.
    # Pin an absolute path so the in-shell binding survives later `cd`s.
    local _abs
    _abs="$(cd "$3" && pwd)"
    _monom_bind_alias "$2" "$_abs"
    return 0
  fi
  "$_bin" "$@"
}

# _monom_log — append a timestamped debug line to $MONOM_DEBUG_LOG.
# No-op (and no subprocess spawned) when MONOM_DEBUG_LOG is unset or empty.
# Log file grows unboundedly; truncate between sessions as needed.
_monom_log() {
  [ -n "$MONOM_DEBUG_LOG" ] || return 0
  printf '[%s] %s\n' "$(date +%T)" "$*" >> "$MONOM_DEBUG_LOG"
}

# _monom_cfg — thin wrapper so call sites read as `_monom_cfg complete`
# instead of `"$_MONOM_USER_CONFIG" complete`.
_monom_cfg() { "$_MONOM_USER_CONFIG" "$@"; }

# _setup_monom — ensures _MONOM_PROJECT_ROOT and _MONOM_USER_CONFIG are set,
# then resolves the effective MONOM_DEBUG_LOG via the optional `debug` hook.
# Short-circuits root discovery if _MONOM_PROJECT_ROOT is already exported.
# Returns non-zero when no project root can be found.
_setup_monom() {
  _monom_log "[_setup_monom] PWD=$PWD _MONOM_PROJECT_ROOT=${_MONOM_PROJECT_ROOT:-<unset>}"
  if [ -n "$_MONOM_PROJECT_ROOT" ]; then
    export _MONOM_USER_CONFIG="$_MONOM_PROJECT_ROOT/monom"
    _monom_log "[_setup_monom] short-circuit: using existing root=$_MONOM_PROJECT_ROOT"
  else
    local root root_err
    root=$(mnmd root 2>/tmp/_monom_root_err) || {
      root_err=$(cat /tmp/_monom_root_err 2>/dev/null)
      _monom_log "[_setup_monom] mnmd root failed: $root_err"
      return 1
    }

    _monom_log "[_setup_monom] mnmd root found: $root"
    export _MONOM_PROJECT_ROOT="$root"
    export _MONOM_USER_CONFIG="$_MONOM_PROJECT_ROOT/monom"
  fi

  # The optional `debug` hook may print a project-local debug log path that
  # overrides the inherited global MONOM_DEBUG_LOG (local overrides global).
  # Invalid (multiline) or unwritable hook output falls back to the inherited
  # value. Stderr diagnostics never reach the user mid-Tab: the completion
  # handlers call `_setup_monom 2>/dev/null`.
  local debug_candidate
  debug_candidate=$(_monom_cfg debug 2>/dev/null)
  case "$debug_candidate" in
    '') ;; # hook absent or printed nothing: inherited global stands
    *$'\n'*)
      echo "monom: ignoring debug hook: multiline output" >&2
      _monom_log "[_setup_monom] debug hook printed multiline output; keeping inherited MONOM_DEBUG_LOG"
      ;;
    *)
      # Probe append-writability in a subshell so a redirection failure
      # cannot abort the caller (`:` is a POSIX special builtin).
      if ( : >> "$debug_candidate" ) 2>/dev/null; then
        export MONOM_DEBUG_LOG="$debug_candidate"
      else
        echo "monom: ignoring debug hook: path not writable: $debug_candidate" >&2
        _monom_log "[_setup_monom] debug hook path not writable: $debug_candidate; keeping inherited MONOM_DEBUG_LOG"
      fi
      ;;
  esac
  [ -z "$MONOM_DEBUG_LOG" ] || _monom_log "[_setup_monom] effective MONOM_DEBUG_LOG=$MONOM_DEBUG_LOG"
  return 0
}

# _monom_list_group — prints a "command group" message and lists children.
# $1: display name (e.g. "monom" or an alias name) used as the message prefix
# $2: label (e.g. the name itself, or "'infra' is a command group")
# remaining args: filter prefix tokens (omit for top-level)
_monom_list_group() {
  local name="$1" label="$2"
  shift 2
  echo "$name: $label" >&2
  local children
  # A trailing "" tells filter to drill into this level's children. complete
  # stays the single source of truth so the listing matches <Tab>.
  children=$(_monom_cfg complete 2>/dev/null | mnmd filter "$@" "" 2>/dev/null)
  if [ -n "$children" ]; then
    local available
    available=$(printf '%s' "$children" | tr '\n' ' ')
    available="${available% }"
    echo "available: ${available// /, }" >&2
  fi
}

# _monom_run — shared execution core for `monom` and every alias. $1 is the
# display name used in messages; the rest are the user's command tokens. Reads
# _MONOM_PROJECT_ROOT from scope — auto-discovered by _setup_monom for bare
# `monom`, or pinned as a `local` by an alias function. Resolves args to an
# executable path via mnmd pack and runs it in a subshell via exec.
_monom_run() {
  local _name="$1"
  shift
  if ! _setup_monom; then
    echo "$_name: no project root found" >&2
    return 1
  fi

  # A pinned root (from an alias) may have moved or lost its config since it was
  # bound; _setup_monom's short-circuit does not re-validate. Fail clearly here
  # rather than surfacing a cryptic exec failure from _monom_cfg.
  if [ ! -x "$_MONOM_USER_CONFIG" ]; then
    echo "$_name: project config not found or not executable: $_MONOM_USER_CONFIG" >&2
    return 1
  fi

  if [ $# -eq 0 ]; then
    _monom_list_group "$_name" "$_name"
    return 1
  fi

  local hook_out hook_err hook_status
  hook_err=$(mktemp)
  hook_out=$(_monom_cfg run "$@" 2>"$hook_err")
  hook_status=$?
  if [ "$hook_status" -ne 0 ]; then
    echo "$_name: run hook failed (exit $hook_status)" >&2
    [ -s "$hook_err" ] && cat "$hook_err" >&2
    rm -f "$hook_err"
    return "$hook_status"
  fi
  rm -f "$hook_err"

  local unpacked_args
  if [ -n "$hook_out" ]; then
    # shellcheck disable=SC2207
    unpacked_args=($(printf '%s' "$hook_out"))
  else
    unpacked_args=("$@")
  fi

  local pack_out pack_err pack_status
  pack_err=$(mktemp)
  pack_out=$(mnmd pack "${unpacked_args[@]}" 2>"$pack_err")
  pack_status=$?

  if [ "$pack_status" -eq 0 ]; then
    rm -f "$pack_err"
    # Run via exec in a subshell so the user's interactive session is not replaced.
    ( exec "$pack_out" )
    return
  fi

  if [ "$pack_status" -eq 3 ]; then
    rm -f "$pack_err"
    # Last typed token names the group. Iterating the array lands on the final
    # element in both bash and zsh without relying on shell-specific indexing.
    local group_name=""
    local _w
    for _w in "${unpacked_args[@]}"; do
      group_name="$_w"
    done
    _monom_list_group "$_name" "'$group_name' is a command group" "${unpacked_args[@]}"
    return 1
  fi

  # Any other non-zero exit is a real error; forward pack's stderr verbatim.
  [ -s "$pack_err" ] && cat "$pack_err" >&2
  rm -f "$pack_err"
  return 1
}

# monom — the command the user calls. A thin caller over the shared core with
# no pinned root, so _setup_monom auto-discovers from $PWD.
monom() { _monom_run monom "$@"; }

# _monom_bind_alias — bind command <name> to project <root> in the current
# shell: a function that pins the root and delegates to _monom_run, plus a
# matching completion binding that pins the same root and delegates to the
# shared completion core. This is pure surface — defining a function and
# registering a completion hook, both shell's job. The eval is unavoidable
# because <name> is dynamic: bash/zsh cannot declare a variably-named function
# any other way. Called both interactively (via `mnmd alias`) and at shell
# startup (from the rc line `mnmd alias-save` writes), spawning no subprocess.
_monom_bind_alias() {
  local _name="$1" _root="$2"
  # `local -x`: the pinned root must be *exported* so the `mnmd pack`/`mnmd
  # filter` child processes discover it, but stay *local* so it is restored (to
  # unset, or whatever bare `monom` last exported) when the call returns — that
  # is what keeps aliases from clobbering each other or bare `monom` discovery.
  eval "${_name}() { local -x _MONOM_PROJECT_ROOT='${_root}'; _monom_run '${_name}' \"\$@\"; }"
  if [ -n "$ZSH_VERSION" ]; then
    eval "_monom_alias_complete_${_name}() { local -x _MONOM_PROJECT_ROOT='${_root}'; _monom_complete_zsh; }"
    if (( ${+functions[compdef]} )); then
      compdef "_monom_alias_complete_${_name}" "$_name"
    fi
  elif [ -n "$BASH_VERSION" ]; then
    eval "_monom_alias_complete_${_name}() { local -x _MONOM_PROJECT_ROOT='${_root}'; _monom_complete; }"
    complete -F "_monom_alias_complete_${_name}" "$_name"
  fi
}

# Source the shell-specific completion binding.
if [ -n "$ZSH_VERSION" ]; then
  # shellcheck disable=SC1091
  . "$_MONOM_LIB_ROOT/monom.zsh"
elif [ -n "$BASH_VERSION" ]; then
  # shellcheck disable=SC1091
  . "$_MONOM_LIB_ROOT/monom.bash"
fi
