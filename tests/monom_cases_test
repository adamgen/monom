#!/usr/bin/env bash
# Declarative CLI cases: runs every tests/cases/*.yaml file through the real
# shell integration (bash and zsh). See tests/README.md for the case format.
#
# Run all:        bash tests/monom_cases_test
# Run one file:   CASES=tests/cases/monom_run.yaml bash tests/monom_cases_test

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# MONOMD is used by oneTimeSetUp() in helpers to build the binary before tests run.
# shellcheck disable=SC2034
MONOMD="$REPO_ROOT/bin/mnmd"
SHUNIT2="$REPO_ROOT/dependencies/shunit2"
SRC_MONOM="$REPO_ROOT/src/monom"

# shellcheck disable=SC1091
. "$SCRIPT_DIR/helpers"

# ---------------------------------------------------------------------------
# Parsed cases, one array slot per case.
# ---------------------------------------------------------------------------

CASE_NAME=()    # case title
CASE_WHERE=()   # file:line of the case header
CASE_ROOT=()    # project root, relative to the repo root
CASE_SHELLS=()  # space-separated shells to run in
CASE_INPUT=()   # the CLI line typed
CASE_ACTION=()  # enter | tab
CASE_EXPECT=()  # expected output (enter) or candidates (tab), newline-separated
CASE_EXIT=()    # expected exit code (enter only)
CASE_MATCH=()   # exact | normalized
CASE_FUNCS=()   # generated shUnit2 test function names

# case_add <name> <file:line> <root> <shells> <input> <action> <expect> <exit> <match>
# — called once per case by the output of tools/cases, which has already
# validated the YAML. Registers one shUnit2 test function per shell.
case_add() {
  local i=${#CASE_NAME[@]}
  CASE_NAME+=("$1")
  CASE_WHERE+=("$2")
  CASE_ROOT+=("$3")
  CASE_SHELLS+=("$4")
  CASE_INPUT+=("$5")
  CASE_ACTION+=("$6")
  CASE_EXPECT+=("$7")
  CASE_EXIT+=("$8")
  CASE_MATCH+=("$9")

  local file="${2%:*}" sh fn base
  base="test_$(slug "$(basename "$file" .yaml)")__$(slug "$1")"
  for sh in $4; do
    fn="${base}__${sh}"
    eval "$fn() { run_case $i $sh; }"
    CASE_FUNCS+=("$fn")
  done
}

# slug <text> — lowercase, non-alphanumerics collapsed to "_".
slug() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '_')
  s="${s#_}"
  printf '%s' "${s%_}"
}

# ---------------------------------------------------------------------------
# Running a case
# ---------------------------------------------------------------------------

# Builds the script a case runs inside a fresh shell: cd into the project root,
# source src/monom exactly as a user's rc file does, then act.
case_script() {
  local sh="$1" root="$2" input="$3" action="$4" qinput
  qinput=$(printf '%q' "$input")

  printf 'cd %q || exit 97\n' "$REPO_ROOT/$root"
  # zsh: compinit before sourcing, the standard .zshrc order, so compdef
  # registers the real completion functions in $_comps.
  [ "$sh" = zsh ] && [ "$action" = tab ] && printf '%s\n' 'autoload -Uz compinit && compinit -D -u'
  printf 'source %q\n' "$SRC_MONOM"

  if [ "$action" = enter ]; then
    printf '%s\n' "$input"
    return
  fi

  if [ "$sh" = bash ]; then
    cat <<EOF
COMP_LINE=$qinput
read -ra COMP_WORDS <<< "\$COMP_LINE"
case "\$COMP_LINE" in *' '|'') COMP_WORDS+=("") ;; esac
COMP_POINT=\${#COMP_LINE}
COMP_CWORD=\$(( \${#COMP_WORDS[@]} - 1 ))
_spec=\$(complete -p "\${COMP_WORDS[0]}" 2>/dev/null) || { echo "no bash completion registered for '\${COMP_WORDS[0]}'" >&2; exit 98; }
_fn=\${_spec##*-F }
_fn=\${_fn%% *}
COMPREPLY=()
"\$_fn" "\${COMP_WORDS[0]}" "\${COMP_WORDS[COMP_CWORD]}" "\${COMP_WORDS[COMP_CWORD-1]}"
[ \${#COMPREPLY[@]} -eq 0 ] || printf '%s\n' "\${COMPREPLY[@]}"
EOF
  else
    cat <<EOF
_line=$qinput
words=(\${(z)_line})
[[ \$_line == *' ' || -z \$_line ]] && words+=('')
CURRENT=\${#words}
PREFIX=\${words[CURRENT]}
_fn=\${_comps[\${words[1]}]}
[[ -n \$_fn ]] || { print -u2 "no zsh completion registered for '\${words[1]}'"; exit 98; }
# Candidates reach zsh through compadd, which offers only those matching the
# word under the cursor. Print exactly those instead, skipping options.
compadd() {
  while (( \$# )) && [[ \$1 == -* ]]; do [[ \$1 == -- ]] && { shift; break; }; shift; done
  local c
  for c in "\$@"; do [[ \$c == "\$PREFIX"* ]] && printf '%s\n' "\$c"; done
  return 0
}
"\$_fn"
EOF
  fi
}

# normalize <mode> <action> — reads text on stdin and prints the form that is
# compared. tab: candidates, sorted. normalized: whitespace runs collapsed,
# lines trimmed, blank lines dropped.
normalize() {
  local mode="$1" action="$2"
  if [ "$mode" = normalized ]; then
    sed -e 's/[[:space:]][[:space:]]*/ /g' -e 's/^ //' -e 's/ $//' | grep -v '^$'
  else
    cat
  fi | if [ "$action" = tab ]; then LC_ALL=C sort; else cat; fi
}

run_case() {
  local i="$1" sh="$2"
  local root="${CASE_ROOT[$i]}" input="${CASE_INPUT[$i]}" action="${CASE_ACTION[$i]}"
  local match="${CASE_MATCH[$i]}" want_exit="${CASE_EXIT[$i]}"

  if ! command -v "$sh" > /dev/null 2>&1; then
    echo "SKIP: $sh not available"
    return
  fi

  local script errfile actual status stderr=""
  script=$(case_script "$sh" "$root" "$input" "$action")
  errfile=$(mktemp)
  local -a cmd=(bash --norc --noprofile -c "$script")
  [ "$sh" = zsh ] && cmd=(zsh --no-rcs -c "$script")
  local -a clean_env=(env -u _MONOM_PROJECT_ROOT -u _MONOM_USER_CONFIG -u MONOM_DEBUG_LOG -u MONOM_ACTIVE)

  if [ "$action" = enter ]; then
    # What the user sees: stdout and stderr interleaved.
    actual=$("${clean_env[@]}" "${cmd[@]}" 2>&1)
    status=$?
  else
    actual=$("${clean_env[@]}" "${cmd[@]}" 2>"$errfile")
    status=$?
    stderr=$(cat "$errfile")
  fi
  rm -f "$errfile"

  local want got
  want=$(printf '%s' "${CASE_EXPECT[$i]}" | normalize "$match" "$action")
  got=$(printf '%s' "$actual" | normalize "$match" "$action")

  local problems=""
  [ "$want" = "$got" ] || problems="output differs"
  if [ "$action" = enter ] && [ "$status" != "$want_exit" ]; then
    problems="${problems:+$problems; }exit code $status, expected $want_exit"
  fi
  if [ "$action" = tab ]; then
    [ "$status" = 0 ] || problems="${problems:+$problems; }completion exited $status"
    [ -z "$stderr" ] || problems="${problems:+$problems; }completion wrote to stderr"
  fi
  [ -z "$problems" ] && return 0

  local report
  report=$(
    printf '\n  case:   %s  (%s)\n' "${CASE_NAME[$i]}" "${CASE_WHERE[$i]}"
    printf '  shell:  %s    root: %s\n' "$sh" "$root"
    printf '  input:  "%s"\n' "$input"
    printf '  action: %s    match: %s%s\n' "$action" "$match" "$([ "$action" = tab ] && echo ' (candidates sorted)')"
    printf '  result: %s\n' "$problems"
    local show_want="$want" show_got="$got"
    if [ "$want" != "$got" ] && [ "$(printf '%s' "$want" | normalize normalized "$action")" = "$(printf '%s' "$got" | normalize normalized "$action")" ]; then
      printf '  note:   differs only in whitespace (shown as · for space, → for tab)\n'
      show_want=$(printf '%s' "$want" | sed -e 's/ /·/g' -e 's/\t/→/g')
      show_got=$(printf '%s' "$got" | sed -e 's/ /·/g' -e 's/\t/→/g')
    fi
    diff -u --label expected --label actual <(printf '%s\n' "$show_want") <(printf '%s\n' "$show_got") | sed 's/^/    /'
    [ -z "$stderr" ] || printf '  stderr:\n%s\n' "$(printf '%s\n' "$stderr" | sed 's/^/    /')"
  )
  fail "$report"
  return 0
}

# ---------------------------------------------------------------------------
# Suite
# ---------------------------------------------------------------------------

# Load the cases: tools/cases parses and strictly validates the YAML (Go,
# gopkg.in/yaml.v3) and prints one case_add line per case. Any schema problem
# aborts the run before a single test starts.
CASES_TOOL="$REPO_ROOT/bin/monom-cases"
if ! (cd "$REPO_ROOT" && go build -o "$CASES_TOOL" ./tools/cases); then
  echo "FATAL: could not build tools/cases" >&2
  exit 1
fi
case_files=()
if [ -n "${CASES:-}" ]; then
  for f in $CASES; do case_files+=("${f#"$REPO_ROOT"/}"); done
else
  for f in "$SCRIPT_DIR"/cases/*.yaml; do
    [ -e "$f" ] && case_files+=("${f#"$REPO_ROOT"/}")
  done
fi
if [ ${#case_files[@]} -gt 0 ]; then
  case_defs=$(cd "$REPO_ROOT" && "$CASES_TOOL" -repo . "${case_files[@]}") || exit 1
  eval "$case_defs"
fi

suite() {
  local fn
  for fn in "${CASE_FUNCS[@]}"; do
    suite_addTest "$fn"
  done
}

# shellcheck disable=SC1090
. "$SHUNIT2"
