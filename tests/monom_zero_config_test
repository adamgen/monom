#!/usr/bin/env bash
# shUnit2 e2e tests: zero-config projects through the shell surface.
#
# A project with no monom config file (or an empty one, or a hook script whose
# `complete` prints nothing) gets its command tree from `mnmd discover`, and
# completion, group listings, and execution all see the same registered set.
#
# Run directly: bash tests/monom_zero_config_test

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# MONOMD is used by oneTimeSetUp() in helpers to build the binary before tests run.
# shellcheck disable=SC2034
MONOMD="$REPO_ROOT/bin/mnmd"
SHUNIT2="$REPO_ROOT/dependencies/shunit2"
SRC_MONOM="$REPO_ROOT/src/monom"

# shellcheck disable=SC1091
. "$SCRIPT_DIR/helpers"

# in_shell <shell> <project> <snippet> — sources src/monom in the named shell
# with the root pinned to the project (as an alias would), then runs snippet.
in_shell() {
  local shell="$1" proj="$2" snippet="$3"
  case "$shell" in
    bash) bash --norc --noprofile -c "
            export _MONOM_PROJECT_ROOT='$proj'
            source '$SRC_MONOM'
            $snippet" 2>&1 ;;
    zsh)  zsh --no-rcs -c "
            export _MONOM_PROJECT_ROOT='$proj'
            source '$SRC_MONOM'
            $snippet" 2>&1 ;;
  esac
}

# bash_tab <project> <words...> — simulates a Tab press in bash and prints
# COMPREPLY, one per line.
bash_tab() {
  local proj="$1"
  shift
  local words="monom" w
  for w in "$@"; do
    words="$words '$w'"
  done
  in_shell bash "$proj" "
    COMP_WORDS=($words)
    COMP_CWORD=\$(( \${#COMP_WORDS[@]} - 1 ))
    _monom_completion
    printf '%s\n' \"\${COMPREPLY[@]}\""
}

has_zsh() {
  if ! command -v zsh > /dev/null 2>&1; then
    echo "SKIP: zsh not available"
    return 1
  fi
}

# ---------------------------------------------------------------------------
# completion
# ---------------------------------------------------------------------------

test_bash_tab_without_monom_file_offers_discovered_top_level() {
  local proj result
  proj=$(make_zero_config_project)
  result=$(bash_tab "$proj" "")
  assert_output_contains_line "deploy offered"  "$result" "deploy"
  assert_output_contains_line "build offered"   "$result" "build"
  assert_output_contains_line "scripts offered" "$result" "scripts"
  assert_output_lacks_line "ungated executable not offered" "$result" "notes.TXT"
  assert_output_lacks_line "private dir not offered"        "$result" "_lib"
  assert_output_lacks_line "dependency dir not offered"     "$result" "node_modules"
  rm -rf "$proj"
}

test_bash_tab_drills_into_discovered_group() {
  local proj result
  proj=$(make_zero_config_project)
  result=$(bash_tab "$proj" build "")
  assertEquals "group children come from discovery" "compile" "$result"
  rm -rf "$proj"
}

test_bash_tab_with_empty_monom_file_offers_discovered_commands() {
  local proj result
  proj=$(make_zero_config_project)
  touch "$proj/monom"
  result=$(bash_tab "$proj" "")
  assert_output_contains_line "deploy offered" "$result" "deploy"
  rm -rf "$proj"
}

test_zsh_complete_pipeline_without_monom_file_uses_discovery() {
  has_zsh || return
  local proj result
  proj=$(make_zero_config_project)
  result=$(in_shell zsh "$proj" "_setup_monom; _monom_complete")
  assert_output_contains_line "deploy discovered in zsh" "$result" "deploy"
  assert_output_contains_line "build/compile discovered in zsh" "$result" "build/compile"
  assert_output_lacks_line "ungated executable excluded in zsh" "$result" "notes.TXT"
  rm -rf "$proj"
}

# ---------------------------------------------------------------------------
# the complete hook still wins when it prints something
# ---------------------------------------------------------------------------

test_complete_hook_output_replaces_discovery() {
  local proj result
  proj=$(make_zero_config_project)
  cat > "$proj/monom" <<'CFG'
#!/bin/sh
case "$1" in
  complete) echo deploy ;;
esac
CFG
  chmod +x "$proj/monom"
  result=$(in_shell bash "$proj" "_setup_monom; _monom_complete")
  assertEquals "complete hook is the single source of truth" "deploy" "$result"
  rm -rf "$proj"
}

test_hook_script_without_complete_arm_falls_back_to_discovery() {
  local proj result
  proj=$(make_zero_config_project)
  cat > "$proj/monom" <<'CFG'
#!/bin/sh
case "$1" in
  run) ;;
esac
CFG
  chmod +x "$proj/monom"
  result=$(in_shell bash "$proj" "_setup_monom; _monom_complete")
  assert_output_contains_line "absent complete hook falls back" "$result" "build/compile"
  rm -rf "$proj"
}

# ---------------------------------------------------------------------------
# execution and listings
# ---------------------------------------------------------------------------

test_bash_runs_discovered_commands_without_monom_file() {
  local proj output
  proj=$(make_zero_config_project)
  output=$(in_shell bash "$proj" "monom deploy; monom build compile")
  assert_output_contains_line "shebang command runs"    "$output" "deploying..."
  assert_output_contains_line "shebangless command runs" "$output" "compiling..."
  rm -rf "$proj"
}

test_zsh_runs_discovered_command_without_monom_file() {
  has_zsh || return
  local proj output
  proj=$(make_zero_config_project)
  output=$(in_shell zsh "$proj" "monom deploy")
  assert_output_contains_line "shebang command runs in zsh" "$output" "deploying..."
  rm -rf "$proj"
}

test_bash_no_args_lists_discovered_top_level() {
  local proj output
  proj=$(make_zero_config_project)
  output=$(in_shell bash "$proj" "monom")
  assert_output_contains_line "no-args lists discovered commands" \
    "$output" "available: build, deploy, scripts"
  rm -rf "$proj"
}

test_bash_group_listing_uses_discovery() {
  local proj output
  proj=$(make_zero_config_project)
  output=$(in_shell bash "$proj" "monom build")
  assert_output_contains_line "group is reported" "$output" "monom: 'build' is a command group"
  assert_output_contains_line "children come from discovery" "$output" "available: compile"
  rm -rf "$proj"
}

# shellcheck disable=SC1090
. "$SHUNIT2"
