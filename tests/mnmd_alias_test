test_zsh_alias_completion_yields_project_top_level() {
  if ! command -v zsh > /dev/null 2>&1; then echo "SKIP: zsh not available"; return; fi
  local proj home output
  proj=$(make_alias_project A)
  home=$(mktemp -d)
  # Mock compadd to print what the alias completion core would offer.
  output=$(zsh --no-rcs -c "
    export HOME='$home'
    export SHELL='/bin/zsh'
    source '$SRC_MONOM'
    compadd() { printf '%s\n' \"\$@\"; }
    mnmd alias myapp '$proj' >/dev/null 2>&1
    words=(myapp '')
    _monom_alias_complete_myapp
  " 2>/dev/null)
  assert_output_contains_line "zsh alias completion should offer the pinned project's top level" \
    "$output" "release"
  assert_output_contains_line "zsh alias completion should offer the pinned project's top level" \
    "$output" "infra"
  rm -rf "$proj" "$home"
}

# shellcheck disable=SC1090
. "$SHUNIT2"
